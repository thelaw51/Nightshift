@inherits LayoutComponentBase
@inject IOptions<NightshiftOptions> Options

@* The app shell: a sample-data banner when that mode is on, then the page. *@

@if (Options.Value.SampleData)
{
    <div class="sample-banner" role="status">Sample data. Nightshift isn't connected to Sonarr, and these shows aren't real.</div>
}

@Body

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">×</button>
</div>
